---
import "../styles/main.css";
import { SITE_NAME } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** Raw <head> markup from Yoast SEO (WPGraphQL) */
  fullHeaddata?: string;
}

const { title, description, fullHeaddata } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const FONT_URL =
  "https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800&display=swap";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title || SITE_NAME}</title>
{!fullHeaddata && description && <meta name="description" content={description} />}
<link rel="canonical" href={canonicalURL} />

{fullHeaddata && <Fragment set:html={fullHeaddata} />}

<link rel="icon" href="/favicon.jpg" />

<!-- Fonts: non-blocking -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href={FONT_URL} rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<noscript><link href={FONT_URL} rel="stylesheet" /></noscript>
