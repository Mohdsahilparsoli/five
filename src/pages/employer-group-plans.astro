---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchAPI, pageTitle } from "../lib/wordpress";

const Homequery = `
  query GetEmployerGroupPage {
    page(id: "employer-group", idType: URI) {
      title
      slug
      uri
      seo {
        title
        fullHead
      }
      employerPlan {
        employerGroupTitle
        shopTitle
        shopLeftDiscraption
        shopRightDiscraption
        shopNote
        employerGroupDiscraption
        employerPlan {
          backgroundColor
          sbcPlan
          summaryLink
          paymentLink {
            target
            title
            url
          }
          title
        }
        employerGalarry {
          gallaryProfile {
            node {
              sourceUrl
              mediaDetails {
                height
                width
              }
            }
          }
        }
      }
    }
  }
`;

const response = await fetchAPI(Homequery);
const page = response?.page;
const employer = page?.employerPlan ?? {};

const plans = (employer.employerPlan ?? []).filter((plan) => plan?.title);

const gallery = (employer.employerGalarry ?? [])
  .map((item) => item?.gallaryProfile?.node)
  .filter((image) => image?.sourceUrl);

const safeTarget = (target) => (target === "_blank" ? "_blank" : undefined);

const safeRel = (target) =>
  target === "_blank" ? "noopener noreferrer" : undefined;
---

<BaseLayout title={pageTitle(page)} fullHead={page?.seo?.fullHead}>
  <section
    class="employermain-sec section-padding shoupourplans-sec bg-flow bg-white"
  >
    <!-- DYNAMIC GALLERY -->
    {
      gallery.length > 0 && (
        <div class="imageempoyergroups">
          {gallery.map((image, index) => (
            <img
              src={image.sourceUrl}
              alt={`${employer.employerGroupTitle || page?.title || "Employer Group"} gallery ${index + 1}`}
              width={image.mediaDetails?.width}
              height={image.mediaDetails?.height}
              loading={index === 0 ? "eager" : "lazy"}
            />
          ))}
        </div>
      )
    }

    <div class="container">
      <div>
        <div class="container">
          <div class="employer-holderss">
            <h1 class="fs-40">
              {employer.employerGroupTitle || page?.title}
            </h1>

            {
              employer.employerGroupDiscraption && (
                <div
                  class="allaboutgroups"
                  set:html={employer.employerGroupDiscraption}
                />
              )
            }
          </div>

          <div class="shopaboutgriops">
            {
              employer.shopTitle && (
                <h2 class="fs-40 text-center">{employer.shopTitle}</h2>
              )
            }

            <div class="row gy-4 justify-content-center">
              {
                employer.shopLeftDiscraption && (
                  <div class="col-lg-6">
                    <div
                      class="shopplnas-data"
                      set:html={employer.shopLeftDiscraption}
                    />
                  </div>
                )
              }

              {
                employer.shopRightDiscraption && (
                  <div class="col-lg-6">
                    <div
                      class="shopplnas-data"
                      set:html={employer.shopRightDiscraption}
                    />
                  </div>
                )
              }

              {
                employer.shopNote && (
                  <div class="col-12">
                    <div class="last-dataaa">
                      <p>{employer.shopNote}</p>
                    </div>
                  </div>
                )
              }
            </div>
          </div>
        </div>
      </div>

      <!-- DYNAMIC PLANS -->
      {
        plans.length > 0 && (
          <div class="plans-gridholders">
            <div class="row justify-content-center">
              <div class="col-10 mx-auto">
                <div class="row justify-content-center">
                  {plans.map((plan) => (
                    <div class="col-md-6 col-lg-6">
                      <div class="holders-planssss">
                        <h4 class="fs-20">{plan.title}</h4>

                        <div class="image-holderssplanss">
                          <div
                            class="allchild-holders"
                            style={`background:${/^#[0-9a-fA-F]{3,8}$/.test(plan.backgroundColor || "") ? plan.backgroundColor : "#ffffff"}`}
                          >
                            <div class="image-dtaaplans">
                              <img
                                src="/assets/img/logoplans.png"
                                width="350"
                                height="160"
                                loading="lazy"
                                alt={plan.title}
                              />
                            </div>
                          </div>
                        </div>

                        <div class="button-plansss">
                          <div class="grid-butttonsplans">
                            {plan.summaryLink && (
                              <div class="universal-newbutton btns">
                                <a
                                  href={plan.summaryLink}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="newbutton-universal"
                                  style="font-weight: 600;"
                                >
                                  Medical Benefit Summary
                                </a>
                              </div>
                            )}

                            {plan.sbcPlan && plan.sbcPlan !== "#" && (
                              <div class="universal-newbutton btns">
                                <a
                                  href={plan.sbcPlan}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="newbutton-universal"
                                  style="font-style: normal; font-weight: 700;"
                                >
                                  {plan.title.trim()} SBC
                                </a>
                              </div>
                            )}

                            {plan.paymentLink?.url && (
                              <a
                                href={plan.paymentLink.url}
                                target={safeTarget(plan.paymentLink.target)}
                                rel={safeRel(plan.paymentLink.target)}
                                class="c-btn"
                              >
                                Enroll Now
                              </a>
                            )}
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
