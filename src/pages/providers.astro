---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchAPI, pageTitle } from "../lib/wordpress";

const Homequery = `query GetPage {
  page(id: "providers", idType: URI) {
    title
    slug
    uri
    seo {
      title
      fullHead
    }
    providres {
      providerHeroTitle
      providerHeroDiscraption
      providerLoginTitle
      providerLoginPicture {
        node {
          sourceUrl
          mediaDetails {
            height
            width
          }
        }
      }
      providerLoginLink {
        target
        title
        url
      }
      providerResetLink {
        target
        title
        url
      }
      providerLoginDiscraption
      securePortalTitle
      secureProviderDiscraption
      networkTitle
      networkParticipationList {
        networkParticipationDiscraption
        networkParticipationSubTitle
        networkParticipationTitle
      }
      enrolledSmallTitle
      enrolledMainTitle
      enrolledDiscraption
      enrolledLink {
        target
        title
        url
      }
      enrolledPicture {
        node {
          sourceUrl
          mediaDetails {
            height
            width
          }
        }
      }
    }
  }
}`;

const response = await fetchAPI(Homequery);
const page = response?.page;
const data = page?.providres;

// Hero image is currently available through the WordPress Yoast OG image.
const heroImage =
  page?.seo?.fullHead?.match(
    /<meta property="og:image" content="([^"]+)"/,
  )?.[1] || "/assets/img/providerimg.webp";

const providerImage =
  data?.providerLoginPicture?.node?.sourceUrl || "/assets/img/wwww.webp";

const enrolledImage =
  data?.enrolledPicture?.node?.sourceUrl || "/assets/img/doctor.png";

const loginLink = data?.providerLoginLink;
const resetLink = data?.providerResetLink;
const enrolledLink = data?.enrolledLink;

const networkItems = data?.networkParticipationList ?? [];

const secureDescription = data?.secureProviderDiscraption ?? "";

const loginDescription = data?.providerLoginDiscraption ?? "";
---

<BaseLayout title={pageTitle(page)} fullHead={page?.seo?.fullHead}>
  <!-- Hero Section -->
  <section class="member-sec provider pt">
    <div class="container">
      <div class="row gy-4 align-items-center">
        <div class="col-lg-7">
          <div class="allabout-memberss">
            <h1 class="fs-60">
              {data?.providerHeroTitle || "Welcome Providers"}
            </h1>

            <p>
              {
                data?.providerHeroDiscraption ||
                  "We're here to support you in caring for your patients, our members."
              }
            </p>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="image-members">
            <img
              src={heroImage}
              alt={data?.providerHeroTitle || "Providers"}
              width="560"
              height="373"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Provider Portal Section -->
  <section class="memberportal-secc">
    <div class="container">
      <div class="holderebg-here">
        <div class="center-data">
          <h2 class="fs-40 text-blue">
            {data?.providerLoginTitle || "Your Provider Portal"}
          </h2>
        </div>
      </div>
    </div>

    <div class="imgaebg">
      <div class="container">
        <div class="main-imageheree">
          <img
            src={providerImage}
            alt={data?.providerLoginTitle || "Provider Portal"}
            width={data?.providerLoginPicture?.node?.mediaDetails?.width || 599}
            height={data?.providerLoginPicture?.node?.mediaDetails?.height ||
              437}
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="container">
      <div class="bootm-childdata">
        <div class="grid-btnssss">
          <div class="databutton">
            <a
              href={loginLink?.url ||
                "https://portal.fivepointsbenefitplans.com/login"}
              target={loginLink?.target || "_blank"}
              rel="noopener noreferrer"
              class="c-btn"
            >
              <span>
                {loginLink?.title || "Login To Your Provider Portal"}
              </span>
            </a>
          </div>

          <div class="databutton">
            <a
              href={resetLink?.url ||
                "https://portal.fivepointsbenefitplans.com/setup-account"}
              target={resetLink?.target || "_blank"}
              rel="noopener noreferrer"
              class="c-btn"
            >
              <span>
                {resetLink?.title || "First Time Login / Reset Password"}
              </span>
            </a>
          </div>
        </div>

        <div set:html={loginDescription} />
      </div>
    </div>
  </section>

  <!-- Secure Provider Portal -->
  <section class="provider-login">
    <div class="container">
      <div class="main-titles-provider">
        <h2 class="fs-30">
          {data?.securePortalTitle || "Secure Provider Portal Login"}
        </h2>

        <div set:html={secureDescription} />
      </div>
    </div>
  </section>

  <!-- Network Participation -->
  <section class="participation-participation">
    <div class="container">
      <div class="main-titles-participation">
        <h2 class="fs-40">
          {data?.networkTitle || "Network Participation"}
        </h2>

        {
          networkItems.length > 0 && (
            <div class="main-tabs-flow">
              <div class="list">
                <ul>
                  {networkItems.map((item, index) => (
                    <li
                      class:list={{ active: index === 0 }}
                      data-tab={`tab${index + 1}`}
                    >
                      {item.networkParticipationSubTitle ||
                        item.networkParticipationTitle}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="main-tabs">
                {networkItems.map((item, index) => (
                  <div
                    class:list={{ tab: true, active: index === 0 }}
                    id={`tab${index + 1}`}
                  >
                    <h3>
                      {item.networkParticipationTitle ||
                        item.networkParticipationSubTitle}
                    </h3>

                    <p>{item.networkParticipationDiscraption}</p>

                    <a href="/network-participation" class="c-btn">
                      How to apply
                    </a>
                  </div>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Enrolled Section -->
  <section class="enroll">
    <div class="container">
      <div class="enroll-flex">
        <div class="enroll-img">
          <img
            src={enrolledImage}
            alt={data?.enrolledMainTitle || "Provider Enrollment"}
            width={data?.enrolledPicture?.node?.mediaDetails?.width || 1536}
            height={data?.enrolledPicture?.node?.mediaDetails?.height || 1024}
            loading="lazy"
          />
        </div>

        <div class="enroll-content">
          <span>
            {data?.enrolledSmallTitle || "Once You Are Enrolled"}
          </span>

          <h2 class="fs-60">
            {
              data?.enrolledMainTitle ||
                "Claims, Eligibility, and Pre- Authorizations"
            }
          </h2>

          <p>
            {
              data?.enrolledDiscraption ||
                "Login to our provider portal to help you view patient eligibility and coverage and manage claims."
            }
          </p>

          <a
            href={enrolledLink?.url || "/provider-login"}
            target={enrolledLink?.target || undefined}
            rel={enrolledLink?.target === "_blank"
              ? "noopener noreferrer"
              : undefined}
            class="c-btn"
          >
            {enrolledLink?.title || "Claims and Eligibility"}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Page Specific Scripts -->
  <Fragment slot="scripts">
    <script is:inline>
      $(document).ready(function () {
        $(".main-tabs-flow .list li").on("click", function () {
          $(".main-tabs-flow .list li").removeClass("active");
          $(this).addClass("active");

          const tabID = $(this).attr("data-tab");

          $(".main-tabs-flow .main-tabs .tab").removeClass("active");
          $("#" + tabID).addClass("active");
        });
      });
    </script>
  </Fragment>
</BaseLayout>
