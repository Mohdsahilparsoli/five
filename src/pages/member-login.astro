---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchAPI, pageTitle } from "../lib/wordpress";

const Homequery = `
query GetMemberLogin {
  page(id: "member-login", idType: URI) {
    title
    content
    slug
    uri

    seo {
      title
      fullHead
    }

    featuredImage {
      node {
        sourceUrl
        mediaDetails {
          height
          width
        }
      }
    }

    memberLogIn {
      loginHeading

      brandLogo {
        node {
          sourceUrl
          mediaDetails {
            height
            width
          }
        }
      }

      loginLinkPage {
        target
        title
        url
      }

      loginText

      accountLinkSetup {
        target
        title
        url
      }

      portalHeading

      portalLoginList {
        mainPortalLink {
          target
          title
          url
        }
        portalLinkDiscraptions
        portalMainHeading
      }

      healthHeading
      healthDiscraptions

      healthList {
        healthIcon {
          node {
            sourceUrl
            mediaDetails {
              height
              width
            }
          }
        }
        healthTitle
      }

      healthImage {
        node {
          sourceUrl
          mediaDetails {
            height
            width
          }
        }
      }

      securityTitle
      securityDiscraptions
    }
  }
}
`;

const portal = await fetchAPI(Homequery);

const page = portal?.page;
const data = page?.memberLogIn;

const heroImage =
  page?.featuredImage?.node?.sourceUrl || "/assets/img/bg-img.webp";
---

<BaseLayout
  title={pageTitle(page)}
  fullHead={page?.seo?.fullHead}
>

  <!-- ================= LOGIN HERO ================= -->

  <section
    class="portal-login"
    style={`background-image: url(${heroImage})`}
  >
    <div class="container">

      <div class="login-form">

        <!-- Dynamic Logo -->
        {
          data?.brandLogo?.node?.sourceUrl && (
            <div class="main-logo">
              <img
                src={data.brandLogo.node.sourceUrl}
                alt={page?.title || "Five Points Benefit Plans"}
              />
            </div>
          )
        }

        <div class="top-login-content">

          <!-- Dynamic Heading -->
          {data?.loginHeading && (
            <h1>{data.loginHeading}</h1>
          )}

          <!-- Dynamic Login Button -->
          {
            data?.loginLinkPage?.url && (
              <div class="save">
                <a
                  href={data.loginLinkPage.url}
                  target={data.loginLinkPage.target || "_blank"}
                  rel={data.loginLinkPage.target === "_blank"
                    ? "noopener noreferrer"
                    : undefined}
                >
                  {data.loginLinkPage.title}
                </a>
              </div>
            )
          }

          <div class="login-from">

            <div class="divider"></div>

            <!-- Dynamic Login Text -->
            {
              data?.loginText && (
                <div
                  class="bottom-tiles"
                  set:html={data.loginText}
                />
              )
            }

            <!-- Dynamic Activate Button -->
            {
              data?.accountLinkSetup?.url && (
                <div class="activate-btn">
                  <a
                    href={data.accountLinkSetup.url}
                    target={data.accountLinkSetup.target || "_blank"}
                    rel={data.accountLinkSetup.target === "_blank"
                      ? "noopener noreferrer"
                      : undefined}
                  >
                    {data.accountLinkSetup.title}
                  </a>
                </div>
              )
            }

          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ================= MEMBER PORTAL ================= -->

  <section class="login-section">

    <!-- Dynamic Portal Heading -->
    {
      data?.portalHeading && (
        <div class="top-titles">
          <span>{data.portalHeading}</span>
        </div>
      )
    }

    <div class="container">

      <!-- ================= PORTAL LOGIN CARDS ================= -->

      {
        data?.portalLoginList?.length > 0 && (
          <div class="login-from">

            {
              data.portalLoginList.map((item) => (
                <div class="login-flow">

                  <div class="content">

                    <!-- Setup Account / Forgot Password -->
                    {
                      item?.portalMainHeading && (
                        <h3>{item.portalMainHeading}</h3>
                      )
                    }

                    <!-- Description -->
                    {
                      item?.portalLinkDiscraptions && (
                        <p>{item.portalLinkDiscraptions}</p>
                      )
                    }

                  </div>

                  <!-- Dynamic Button -->
                  {
                    item?.mainPortalLink?.url && (
                      <div class="save">
                        <a
                          href={item.mainPortalLink.url}
                          target={item.mainPortalLink.target || "_blank"}
                          rel={item.mainPortalLink.target === "_blank"
                            ? "noopener noreferrer"
                            : undefined}
                        >
                          {item.mainPortalLink.title}
                        </a>
                      </div>
                    )
                  }

                </div>
              ))
            }

          </div>
        )
      }


      <!-- ================= HEALTH PLAN ================= -->

      <div class="otheritles">

        {
          data?.healthHeading && (
            <h2>{data.healthHeading}</h2>
          )
        }

        {
          data?.healthDiscraptions && (
            <p>{data.healthDiscraptions}</p>
          )
        }

      </div>


      <!-- ================= HEALTH FEATURES ================= -->

      {
        data?.healthList?.length > 0 && (
          <div class="main-grild-portal">

            {
              data.healthList.map((item) => (
                <div class="grid-data">

                  {
                    item?.healthTitle && (
                      <span>{item.healthTitle}</span>
                    )
                  }

                  {
                    item?.healthIcon?.node?.sourceUrl && (
                      <img
                        src={item.healthIcon.node.sourceUrl}
                        alt={item.healthTitle || "Health Plan"}
                      />
                    )
                  }

                </div>
              ))
            }

          </div>
        )
      }


      <!-- ================= MIDDLE IMAGE ================= -->

      {
        data?.healthImage?.node?.sourceUrl && (
          <div class="m-img">

            <img
              src={data.healthImage.node.sourceUrl}
              alt="Five Points Benefit Plans Health Plan"
            />

          </div>
        )
      }


      <!-- ================= SECURITY ================= -->

      <div class="main-img-flow">

        <div class="account-secuirty">

          {
            data?.securityTitle && (
              <h3 class="fs-35">
                {data.securityTitle}
              </h3>
            )
          }

          <!-- Dynamic Security Content -->
          {
            data?.securityDiscraptions && (
              <div
                class="security-content"
                set:html={data.securityDiscraptions}
              />
            )
          }

        </div>

      </div>

    </div>
  </section>

</BaseLayout>