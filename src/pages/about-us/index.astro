---
import { fetchAPI, pageTitle } from "../../lib/wordpress";
import BaseLayout from "../../layouts/BaseLayout.astro";

const GetPage = `
  query GetPage {
    page(id: "about-us", idType: URI) {
      title
      content
      slug
      date
      seo {
        title
        fullHead
      }
      featuredImage {
        node {
          sourceUrl
          altText
          mediaDetails {
            width
            height
          }
        }
      }
    }
  }
`;

const postquery = `
  query GetAllPost {
    members {
      nodes {
        title
        slug
        content
        excerpt

        memberCategories {
          nodes {
            name
            slug
          }
        }

        featuredImage {
          node {
            sourceUrl
            altText
            mediaDetails {
              width
              height
            }
          }
        }

        teamProfile {
          email
          phone
          subTitle
        }
      }
    }
  }
`;

// Fetch page and members in parallel
const [data, post] = await Promise.all([
  fetchAPI(GetPage),
  fetchAPI(postquery),
]);

const page = data?.page;
const featured = page?.featuredImage?.node;

const allMembers = post?.members?.nodes ?? [];

// Get category slug
const categoryOf = (member) =>
  member?.memberCategories?.nodes?.[0]?.slug ?? "";

// Separate members by category
const Executive = allMembers.filter(
  (member) => categoryOf(member) === "executive"
);

const Administration = allMembers.filter(
  (member) => categoryOf(member) === "administration"
);
---

<BaseLayout
  title={pageTitle(page)}
  fullHead={page?.seo?.fullHead}
>
  <section class="in-banner">
    <div class="container">

      <!-- Page Title -->
      <div class="main-titles">
        <h1 class="fs-60">{page?.title}</h1>
      </div>

      <!-- Featured Image -->
      <div class="main-about">
        {featured?.sourceUrl && (
          <img
            src={featured.sourceUrl}
            alt={featured?.altText ?? page?.title ?? ""}
            width={featured?.mediaDetails?.width}
            height={featured?.mediaDetails?.height}
          />
        )}
      </div>

      <!-- Team Header -->
      <div class="top-header">
        <div class="top-title">
          <h2 class="fs-80">
            <span>M</span>eet <span>O</span>ur <span>T</span>eam
          </h2>
        </div>

        {Executive.length > 0 && (
          <h3 class="fs-30">Executive team</h3>
        )}
      </div>

      <!-- Team Grid -->
      <div class="main-grid-list">

        <!-- =========================
             EXECUTIVE TEAM
        ========================== -->

        {Executive.map((member) => (
          <a href={`/about-us/${member?.slug ?? ""}`}>
            <div class="grid-card">

              <!-- Member Image -->
              <div class="main-team-img">
                {member?.featuredImage?.node?.sourceUrl && (
                  <img
                    src={member.featuredImage.node.sourceUrl}
                    alt={
                      member?.featuredImage?.node?.altText ??
                      member?.title ??
                      ""
                    }
                    width={
                      member?.featuredImage?.node?.mediaDetails?.width
                    }
                    height={
                      member?.featuredImage?.node?.mediaDetails?.height
                    }
                  />
                )}
              </div>

              <!-- Member Information -->
              <div class="title">
                <h3>{member?.title}</h3>

                {member?.teamProfile?.subTitle && (
                  <p>{member.teamProfile.subTitle}</p>
                )}
              </div>

            </div>
          </a>
        ))}


        <!-- =========================
             ADMINISTRATION
        ========================== -->

        {Administration.length > 0 && (
          <div class="full-titles">
            <h3 class="fs-30">Administration</h3>
          </div>
        )}

        {Administration.map((member) => (
          <a href={`/about-us/${member?.slug ?? ""}`}>
            <div class="grid-card">

              <!-- Member Image -->
              <div class="main-team-img">
                {member?.featuredImage?.node?.sourceUrl && (
                  <img
                    src={member.featuredImage.node.sourceUrl}
                    alt={
                      member?.featuredImage?.node?.altText ??
                      member?.title ??
                      ""
                    }
                    width={
                      member?.featuredImage?.node?.mediaDetails?.width
                    }
                    height={
                      member?.featuredImage?.node?.mediaDetails?.height
                    }
                  />
                )}
              </div>

              <!-- Member Information -->
              <div class="title">
                <h3>{member?.title}</h3>

                {member?.teamProfile?.subTitle && (
                  <p>{member.teamProfile.subTitle}</p>
                )}
              </div>

            </div>
          </a>
        ))}

      </div>
    </div>
  </section>
</BaseLayout>