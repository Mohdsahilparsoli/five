---
import { fetchAPI } from "../../lib/wordpress";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../../consts";

// SSR mode
const slug = (Astro.params.slug ?? "").split("/")[0];

/* SINGLE MEMBER QUERY */
const singleQuery = `
  query GetMember($slug: ID!) {
    member(id: $slug, idType: SLUG) {
      title
      slug
      content
      excerpt

      memberCategories {
        nodes {
          name
          slug
        }
      }

      featuredImage {
        node {
          sourceUrl
          altText
          mediaDetails {
            width
            height
          }
        }
      }

      teamProfile {
        email
        phone
        subTitle
      }
    }
  }
`;

// Fetch member
const data = slug
  ? await fetchAPI(singleQuery, { slug })
  : null;

const member = data?.member;

// Member not found in WordPress → custom 404 page
// (only when WordPress answered; if it's down we don't show a false 404)
if (data && !member) {
  return Astro.rewrite("/404/");
}

// Dynamic data
const profileImage = member?.featuredImage?.node;

const memberName = member?.title ?? "";

const memberSubtitle =
  member?.teamProfile?.subTitle?.trim() ?? "";

const memberEmail =
  member?.teamProfile?.email?.trim() ?? "";

const memberPhone =
  member?.teamProfile?.phone?.trim() ?? "";
---

<BaseLayout
  title={
    memberName
      ? `${memberName}${memberSubtitle ? ` | ${memberSubtitle}` : ""}`
      : SITE_NAME
  }
  description={SITE_DESCRIPTION}
>

  <div class="single-team-mamber">
    <div class="container">

      <div class="main-conent">

        <!-- ==============================
             MEMBER IMAGE + CONTACT
        =============================== -->

        <div class="team-img">

          <div class="img">
            {profileImage?.sourceUrl && (
              <img
                src={profileImage.sourceUrl}
                alt={
                  profileImage?.altText ||
                  memberName ||
                  "Team Member"
                }
                width={profileImage?.mediaDetails?.width}
                height={profileImage?.mediaDetails?.height}
              />
            )}
          </div>


          <!-- ==============================
               CONTACT INFORMATION
          =============================== -->

          <div class="contact-info-flow">
            <div>

              <h3>Contact Information</h3>

              <p>

                {memberEmail && (
                  <>
                    <b>
                      email:<br />
                      <a href={`mailto:${memberEmail}`}>
                        {memberEmail}
                      </a>
                    </b>

                    <br />
                  </>
                )}

                {memberPhone && (
                  <b>
                    phone:{" "}
                    <a href={`tel:${memberPhone}`}>
                      {memberPhone}
                    </a>
                  </b>
                )}

              </p>

            </div>
          </div>

        </div>


        <!-- ==============================
             MEMBER CONTENT
        =============================== -->

        <div class="team-content">

          <!-- MAIN TITLE -->

          {memberName && (
            <h1>
              {memberName}
            </h1>
          )}


          <!-- SUB TITLE / DESIGNATION -->

          {memberSubtitle && (
            <h2>
              {memberSubtitle}
            </h2>
          )}


          <!-- WORDPRESS CONTENT -->

          <div set:html={member?.content ?? ""} />


          <!-- BACK BUTTON -->

          <a href={`${Astro.url.origin}/about-us`}>
            Back to Management Team
          </a>

        </div>

      </div>

    </div>
  </div>

</BaseLayout>