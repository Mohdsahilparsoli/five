---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchAPI, pageTitle } from "../lib/wordpress";

const Homequery = `
  query GetProviderLoginLink {
    page(id: "provider-login", idType: URI) {
      title
      slug
      uri

      seo {
        title
        fullHead
      }

      providerLogin {
        loginHeading

        providerLoginLink {
          title
          url
          target
        }

        brandLogo {
          node {
            sourceUrl
            mediaDetails {
              width
              height
            }
          }
        }

        loginText
        portalHeading

        portalLoginList {
          portalMainHeading
          portalLinkDiscraptions

          mainPortalLink {
            title
            url
            target
          }
        }

        healthHeading
        subHeading
        healthDiscraptions
      }
    }
  }
`;

const response = await fetchAPI(Homequery);
const page = response?.page;
const provider = page?.providerLogin;

const logo = provider?.brandLogo?.node;
const loginLink = provider?.providerLoginLink;
const portalItems = provider?.portalLoginList ?? [];
---

<BaseLayout title={pageTitle(page)} fullHead={page?.seo?.fullHead}>
  <section
    class="portal-login"
    style="background-image: url('/assets/img/main-provider.webp')"
  >
    <div class="container">
      <div class="login-form">
        <!-- Dynamic Logo -->
        <div class="main-logo">
          <img
            src={logo?.sourceUrl || "/assets/img/logo.png"}
            alt="Five Points Benefit Plans"
            width={logo?.mediaDetails?.width || 194}
            height={logo?.mediaDetails?.height || 88}
          />
        </div>

        <div class="top-login-content">
          <!-- Dynamic Login Heading -->
          <h1>{provider?.loginHeading}</h1>

          <!-- Dynamic Login Link -->
          {
            loginLink?.url && (
              <div class="save">
                <a
                  href={loginLink.url}
                  target={loginLink.target || "_self"}
                  rel={
                    loginLink.target === "_blank"
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  {loginLink.title || "Login to Your Account"}
                </a>
              </div>
            )
          }

          <div class="login-from">
            <div class="divider"></div>

            <!-- Dynamic Login Text -->
            {
              provider?.loginText && (
                <div class="bottom-tiles" set:html={provider.loginText} />
              )
            }

            <!-- Dynamic Account Setup Link -->
            {
              portalItems[0]?.mainPortalLink?.url && (
                <div class="activate-btn">
                  <a
                    href={portalItems[0].mainPortalLink.url}
                    target={portalItems[0].mainPortalLink.target || "_self"}
                    rel={
                      portalItems[0].mainPortalLink.target === "_blank"
                        ? "noopener noreferrer"
                        : undefined
                    }
                  >
                    Activate Your Account
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="login-section">
    <!-- Dynamic Portal Heading -->
    <div class="top-titles">
      <span>{provider?.portalHeading}</span>
    </div>

    <div class="container">
      <!-- Dynamic Portal Cards -->
      <div class="login-from">
        {
          portalItems.map((item) => (
            <div class="login-flow">
              <div class="content">
                <h3>{item.portalMainHeading}</h3>
                <p>{item.portalLinkDiscraptions}</p>
              </div>

              {item.mainPortalLink?.url && (
                <div class="save">
                  <a
                    href={item.mainPortalLink.url}
                    target={item.mainPortalLink.target || "_self"}
                    rel={
                      item.mainPortalLink.target === "_blank"
                        ? "noopener noreferrer"
                        : undefined
                    }
                  >
                    {item.mainPortalLink.title || "Learn More"}
                  </a>
                </div>
              )}
            </div>
          ))
        }
      </div>

      <!-- Dynamic Health Heading -->
      <div class="otheritles">
        <h2 class="pb-0">{provider?.healthHeading}</h2>
      </div>

      <!-- Dynamic Health Content -->
      <div class="main-img-flow">
        <div class="account-secuirty">
          {provider?.subHeading && <h3 class="fs-35">{provider.subHeading}</h3>}

          {
            provider?.healthDiscraptions && (
              <div
                class="health-content"
                set:html={provider.healthDiscraptions}
              />
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
