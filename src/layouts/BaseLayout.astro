---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  fullHead?: string;
  noindex?: boolean;
}

const { title, description, fullHead, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} fullHeaddata={fullHead} noindex={noindex} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <slot name="scripts" />
  </body>
</html>
