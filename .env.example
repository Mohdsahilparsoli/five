# Copy to .env for local development. On Vercel: Project → Settings → Environment Variables.

# WordPress WPGraphQL endpoint (default: https://test.admin.fivepointsbenefitplans.com/graphql)
WP_GRAPHQL_URL=

# Public site URL used for canonical links (e.g. https://www.fivepointsbenefitplans.com)
SITE_URL=

# OTP email (src/pages/apix/send-otp.js) — Gmail address + App Password
SMTP_USER=
SMTP_PASS=
# Secret used to sign OTP tokens (any long random string)
OTP_SECRET=
